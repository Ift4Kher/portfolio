datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hero {
  id               String   @id @default(uuid())
  greeting         String   @default("Hello, I'm")
  name             String   @default("Md Iftakhar Ahmed Rifat")
  title            String   @default("Web Developer")
  subtitle         String   @default("Building modern, responsive, and high-performance web applications.")
  profileImage     String   @default("/images/rifat-hero.png")
  primaryCtaText   String   @default("View My Work")
  primaryCtaLink   String   @default("#projects")
  secondaryCtaText String   @default("Download CV")
  secondaryCtaLink String   @default("/cv/rifat-cv.pdf")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model About {
  id                String   @id @default(uuid())
  title             String   @default("About Me")
  description       String   @db.Text
  bio               String   @db.Text
  yearsExperience   Int      @default(3)
  completedProjects Int      @default(25)
  clientsServed     Int      @default(15)
  image             String   @default("/images/rifat-hero.png")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Service {
  id           String   @id @default(uuid())
  title        String
  description  String   @db.Text
  icon         String
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Skill {
  id           String   @id @default(uuid())
  name         String
  category     String   // Frontend, Backend, Database, Tools
  icon         String
  proficiency  Int?     @default(90)
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String            @id @default(uuid())
  name      String            @unique
  slug      String            @unique
  projects  ProjectCategory[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Technology {
  id        String              @id @default(uuid())
  name      String              @unique
  icon      String?
  projects  ProjectTechnology[]
  createdAt DateTime            @default(now())
  updatedAt DateTime          @updatedAt
}

model Project {
  id               String              @id @default(uuid())
  title            String
  slug             String              @unique
  shortDescription String              @db.Text
  fullDescription  String              @db.Text
  overview         String?             @db.Text
  problem          String?             @db.Text
  solution         String?             @db.Text
  keyFeatures      String?             @db.Text
  challenges       String?             @db.Text
  results          String?             @db.Text
  coverImage       String
  githubUrl        String?
  liveDemoUrl      String?
  featured         Boolean             @default(false)
  published        Boolean             @default(true)
  carouselOrder    Int                 @default(0)
  accentColor      String?             @default("#06b6d4")
  gallery          ProjectImage[]
  categories       ProjectCategory[]
  technologies     ProjectTechnology[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model ProjectCategory {
  projectId  String
  categoryId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
}

model ProjectImage {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl     String
  caption      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model Education {
  id           String   @id @default(uuid())
  degree       String
  institution  String
  result       String?
  startDate    String
  endDate      String
  description  String?  @db.Text
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProcessStep {
  id           String   @id @default(uuid())
  stepNumber   String
  title        String
  description  String   @db.Text
  icon         String?
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SocialLink {
  id           String   @id @default(uuid())
  platform     String
  url          String
  icon         String
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  read      Boolean  @default(false)
  ipAddress String?
  createdAt DateTime @default(now())
}

model SiteSetting {
  id              String   @id @default(uuid())
  siteTitle       String   @default("Md Iftakhar Ahmed Rifat — Web Developer Portfolio")
  metaDescription String   @default("Full-stack Web Developer creating modern, responsive web applications.")
  contactEmail    String   @default("rifat.dev@example.com")
  contactPhone    String?
  contactLocation String?  @default("Dhaka, Bangladesh")
  cvUrl           String   @default("/cv/rifat-cv.pdf")
  footerText      String   @default("© 2026 Md Iftakhar Ahmed Rifat. All rights reserved.")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
